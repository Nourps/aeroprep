# Copier en .env puis adapter.

# Nom de domaine public (DuckDNS), utilisé par Caddy pour le certificat HTTPS
DOMAIN=

# Port interne et dossier des données (base SQLite + PDF)
PORT=3000
DATA_DIR=./data

# Emails qui deviennent admin à l'inscription (le tout premier compte est admin dans tous les cas)
ADMIN_EMAILS=

# Mettre true derrière HTTPS (cookies "Secure"). docker-compose le fait déjà.
SECURE_COOKIES=false
# Nombre de proxys de confiance devant l'app (1 avec Caddy/nginx)
TRUST_PROXY=loopback

# DuckDNS (accès Internet) : sous-domaine sans .duckdns.org et token. Peut aussi se régler dans Admin > Réglages.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Clé API Anthropic pour l'assistant IA. Optionnel : peut aussi être saisie dans Admin > Réglages.
# Si elle est définie ici, elle est prioritaire sur celle du panneau admin.
ANTHROPIC_API_KEY=

# Taille max d'un PDF envoyé (Mo)
MAX_UPLOAD_MB=300
# Durée de session (jours)
SESSION_DAYS=30
